@inproceedings{lazzaroniLowNoiseReadoutChannel2022,
  title = {A {{Low-Noise Readout Channel}} for {{X-Ray Ptychography Applications}}},
  booktitle = {2022 {{IEEE Nuclear Science Symposium}} and {{Medical Imaging Conference}} ({{NSS}}/{{MIC}})},
